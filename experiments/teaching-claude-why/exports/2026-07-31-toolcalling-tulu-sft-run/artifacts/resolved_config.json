{
  "seed": 0,
  "model": "Qwen/Qwen3.6-27B",
  "model_class": "image_text_to_text",
  "data_path": "data/mixture_toolcalling.jsonl",
  "output_dir": "output/train_lora_toolcalling",
  "lora": {
    "r": 32,
    "alpha": 64,
    "dropout": 0.05,
    "target_modules": "model\\.language_model\\..*\\.(q_proj|k_proj|v_proj|o_proj|gate_proj|up_proj|down_proj)$"
  },
  "train": {
    "epochs": 1,
    "batch_size": 1,
    "grad_accum": 16,
    "lr": 0.0001,
    "lr_scheduler": "cosine",
    "warmup_ratio": 0.03,
    "logging_steps": 5,
    "max_seq_len": 4096,
    "packing": false,
    "assistant_only_loss": false,
    "attn_implementation": "sdpa",
    "load_in_4bit": false
  }
}