# SecretEnv.psm1
#
# Generic, provider-agnostic secret injection for the MSM vulnerability audit.
#
# Contract enforced by this module:
#   1. KEY=VALUE files are parsed silently.
#   2. Values are injected only into the process that needs them.
#   3. No value is ever written to the output stream, a log, or a file.
#   4. The previous process environment is restored afterwards, including
#      variables that were previously undefined.
#   5. A missing required variable fails loudly, naming only the KEY.
#   6. Nothing generated by this module persists a credential.
#
# Every function here treats values as opaque. Error messages, verbose output
# and evidence records reference key NAMES only.

Set-StrictMode -Version Latest

function Read-SecretFile {
    <#
    .SYNOPSIS
        Parse a KEY=VALUE secret file into a hashtable. Emits no values.
    .OUTPUTS
        System.Collections.Hashtable
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$Path
    )

    if (-not (Test-Path -LiteralPath $Path)) {
        throw "Secret file not found: $Path"
    }

    $table = @{}
    $lineNumber = 0

    foreach ($rawLine in [System.IO.File]::ReadAllLines($Path)) {
        $lineNumber++
        $line = $rawLine.Trim()

        if ($line.Length -eq 0) { continue }
        if ($line.StartsWith('#')) { continue }

        # Tolerate shell-style `export KEY=VALUE`.
        if ($line -match '^export\s+(.+)$') { $line = $Matches[1].Trim() }

        $split = $line.IndexOf('=')
        if ($split -lt 1) {
            # Do not echo the line: it may contain a value.
            throw "Malformed secret line at $Path`:$lineNumber (no KEY= assignment). The line content is intentionally not shown."
        }

        $key = $line.Substring(0, $split).Trim()
        $value = $line.Substring($split + 1)

        if ($key -notmatch '^[A-Za-z_][A-Za-z0-9_]*$') {
            throw "Malformed key name at $Path`:$lineNumber."
        }

        # Strip one layer of surrounding quotes; expand \n inside double quotes
        # so single-line PEM material survives round-tripping.
        if ($value.Length -ge 2 -and $value.StartsWith('"') -and $value.EndsWith('"')) {
            $value = $value.Substring(1, $value.Length - 2).Replace('\n', "`n")
        }
        elseif ($value.Length -ge 2 -and $value.StartsWith("'") -and $value.EndsWith("'")) {
            $value = $value.Substring(1, $value.Length - 2)
        }
        else {
            $value = $value.Trim()
        }

        $table[$key] = $value
    }

    return $table
}

function Assert-RequiredSecrets {
    <#
    .SYNOPSIS
        Fail clearly when a required KEY is absent or empty. Names keys only.
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][hashtable]$Secrets,
        [Parameter(Mandatory)][string[]]$Required,
        [string]$SourceLabel = 'secret file'
    )

    $missing = @()
    foreach ($key in $Required) {
        if (-not $Secrets.ContainsKey($key)) { $missing += "$key (absent)"; continue }
        if ([string]::IsNullOrWhiteSpace($Secrets[$key])) { $missing += "$key (empty)" }
    }

    if ($missing.Count -gt 0) {
        throw "Required variable(s) unusable in $SourceLabel`: $($missing -join ', '). Fix the secret file and retry; no value was read into any log."
    }
}

function Get-SecretFingerprint {
    <#
    .SYNOPSIS
        Non-reversible short fingerprint of a secret, for correlating
        "same credential" across evidence records without exposing it.
    .DESCRIPTION
        SHA-256 over a salted copy of the value, truncated to 12 hex chars.
        This is recorded in evidence files instead of any part of the value.
        No prefix, suffix or length of the original value is revealed.
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][AllowEmptyString()][string]$Value
    )

    $sha = [System.Security.Cryptography.SHA256]::Create()
    try {
        $bytes = [System.Text.Encoding]::UTF8.GetBytes("msm-audit-fingerprint-v1:$Value")
        $hash = $sha.ComputeHash($bytes)
        return (-join ($hash[0..5] | ForEach-Object { $_.ToString('x2') }))
    }
    finally {
        $sha.Dispose()
    }
}

function ConvertTo-WindowsArgumentString {
    <#
    .SYNOPSIS
        Join arguments into a correctly quoted Windows command-line string.
    .DESCRIPTION
        ProcessStartInfo.ArgumentList exists only on .NET Core; Windows
        PowerShell 5.1 runs on .NET Framework and exposes only the single
        Arguments string. This applies the standard CommandLineToArgvW quoting
        rules so paths with spaces survive.

        Arguments are never secrets in this codebase - credentials go through
        the environment block - so nothing sensitive is placed on a command line
        by this function.
    #>
    [CmdletBinding()]
    param([string[]]$ArgumentList)

    if (-not $ArgumentList -or $ArgumentList.Count -eq 0) { return '' }

    $parts = foreach ($arg in $ArgumentList) {
        $a = [string]$arg
        if ($a.Length -gt 0 -and $a -notmatch '[\s"]') {
            $a
        }
        else {
            # Escape backslashes that precede a quote, and the quotes themselves.
            $escaped = [regex]::Replace($a, '(\\*)"', '$1$1\"')
            $escaped = [regex]::Replace($escaped, '(\\+)$', '$1$1')
            '"' + $escaped + '"'
        }
    }
    return ($parts -join ' ')
}

function Invoke-WithSecretEnv {
    <#
    .SYNOPSIS
        Run a scriptblock with secrets present in the environment, then restore
        the environment exactly as it was.
    .DESCRIPTION
        Use this for in-process work such as an authenticated REST call. The
        variables exist only inside this PowerShell process, only for the
        duration of the scriptblock, and are removed in a finally block so an
        exception or Ctrl-C cannot leave them behind.

        For launching an external executable prefer Start-ProcessWithSecretEnv,
        which never places the value in this process at all.
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string[]]$Required,
        [Parameter(Mandatory)][scriptblock]$ScriptBlock,
        [string[]]$Inject,
        [string]$SourceLabel
    )

    if (-not $SourceLabel) { $SourceLabel = (Split-Path -Leaf $Path) }

    $secrets = Read-SecretFile -Path $Path
    Assert-RequiredSecrets -Secrets $secrets -Required $Required -SourceLabel $SourceLabel

    # Default to injecting exactly the required set: least privilege.
    if (-not $Inject -or $Inject.Count -eq 0) { $Inject = $Required }

    $previous = @{}
    foreach ($key in $Inject) {
        if (-not $secrets.ContainsKey($key)) { continue }
        # $null means "was not defined", which is distinct from "was empty".
        $previous[$key] = [System.Environment]::GetEnvironmentVariable($key, 'Process')
    }

    try {
        foreach ($key in $Inject) {
            if (-not $secrets.ContainsKey($key)) { continue }
            [System.Environment]::SetEnvironmentVariable($key, $secrets[$key], 'Process')
        }

        & $ScriptBlock
    }
    finally {
        foreach ($key in $previous.Keys) {
            # Setting to $null removes the variable, restoring "undefined".
            [System.Environment]::SetEnvironmentVariable($key, $previous[$key], 'Process')
        }
        foreach ($key in @($secrets.Keys)) { $secrets[$key] = $null }
        $secrets.Clear()
    }
}

function Start-ProcessWithSecretEnv {
    <#
    .SYNOPSIS
        Launch an external command with secrets injected into that child
        process only. The parent process environment is never modified.
    .DESCRIPTION
        Values are placed directly into the child's ProcessStartInfo
        environment block, so they never exist as a variable in this
        PowerShell process and never appear on the command line (and therefore
        never in the command history or in a process listing).
    .OUTPUTS
        PSCustomObject with ExitCode, StdOut, StdErr.
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string[]]$Required,
        [Parameter(Mandatory)][string]$FilePath,
        [string[]]$ArgumentList = @(),
        [string[]]$Inject,
        [string]$WorkingDirectory,
        [hashtable]$ExtraEnvironment,
        [string]$StdOutFile,
        [string]$StdErrFile,
        [string]$SourceLabel
    )

    if (-not $SourceLabel) { $SourceLabel = (Split-Path -Leaf $Path) }

    $secrets = Read-SecretFile -Path $Path
    Assert-RequiredSecrets -Secrets $secrets -Required $Required -SourceLabel $SourceLabel
    if (-not $Inject -or $Inject.Count -eq 0) { $Inject = $Required }

    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = $FilePath
    $psi.Arguments = ConvertTo-WindowsArgumentString -ArgumentList $ArgumentList
    $psi.UseShellExecute = $false
    $psi.RedirectStandardOutput = $true
    $psi.RedirectStandardError = $true
    $psi.CreateNoWindow = $true
    if ($WorkingDirectory) { $psi.WorkingDirectory = $WorkingDirectory }

    if ($ExtraEnvironment) {
        foreach ($k in $ExtraEnvironment.Keys) { $psi.Environment[$k] = [string]$ExtraEnvironment[$k] }
    }
    foreach ($key in $Inject) {
        if (-not $secrets.ContainsKey($key)) { continue }
        $psi.Environment[$key] = $secrets[$key]
    }

    $proc = $null
    try {
        $proc = [System.Diagnostics.Process]::Start($psi)
        $stdOutTask = $proc.StandardOutput.ReadToEndAsync()
        $stdErrTask = $proc.StandardError.ReadToEndAsync()
        $proc.WaitForExit()
        $stdOut = $stdOutTask.GetAwaiter().GetResult()
        $stdErr = $stdErrTask.GetAwaiter().GetResult()

        if ($StdOutFile) { [System.IO.File]::WriteAllText($StdOutFile, $stdOut) }
        if ($StdErrFile) { [System.IO.File]::WriteAllText($StdErrFile, $stdErr) }

        return [pscustomobject]@{
            ExitCode = $proc.ExitCode
            StdOut   = $stdOut
            StdErr   = $stdErr
        }
    }
    finally {
        if ($proc) { $proc.Dispose() }
        foreach ($key in @($secrets.Keys)) { $secrets[$key] = $null }
        $secrets.Clear()
        # $psi.Environment is released with the local variable; the child holds
        # its own copy and exits with it.
        $psi = $null
    }
}

function Start-DetachedProcessWithSecretEnv {
    <#
    .SYNOPSIS
        Launch a long-lived background process with secrets injected into that
        child only, and return immediately without waiting for it.
    .DESCRIPTION
        Used for the provider monitor and the cleanup watchdog, which must
        outlive the call that started them and must keep working if the
        orchestration dies.

        Set -Visible to give the child its own console window, so the operator
        has a dedicated terminal showing live status. Output is not redirected in
        that mode, because redirecting would hide the window's purpose; the
        scripts also persist their status to files, so nothing depends on the
        window existing.
    .OUTPUTS
        PSCustomObject with ProcessId and StartedAt.
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string[]]$Required,
        [Parameter(Mandatory)][string]$FilePath,
        [string[]]$ArgumentList = @(),
        [string[]]$Inject,
        [string]$WorkingDirectory,
        [hashtable]$ExtraEnvironment,
        [switch]$Visible,
        [string]$SourceLabel
    )

    if (-not $SourceLabel) { $SourceLabel = (Split-Path -Leaf $Path) }

    $secrets = Read-SecretFile -Path $Path
    Assert-RequiredSecrets -Secrets $secrets -Required $Required -SourceLabel $SourceLabel
    if (-not $Inject -or $Inject.Count -eq 0) { $Inject = $Required }

    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = $FilePath
    $psi.Arguments = ConvertTo-WindowsArgumentString -ArgumentList $ArgumentList
    $psi.UseShellExecute = $false
    $psi.CreateNoWindow  = (-not $Visible)
    $psi.RedirectStandardOutput = $false
    $psi.RedirectStandardError  = $false
    if ($WorkingDirectory) { $psi.WorkingDirectory = $WorkingDirectory }

    if ($ExtraEnvironment) {
        foreach ($k in $ExtraEnvironment.Keys) { $psi.Environment[$k] = [string]$ExtraEnvironment[$k] }
    }
    foreach ($key in $Inject) {
        if (-not $secrets.ContainsKey($key)) { continue }
        $psi.Environment[$key] = $secrets[$key]
    }

    try {
        $proc = [System.Diagnostics.Process]::Start($psi)
        return [pscustomobject]@{
            ProcessId = $proc.Id
            StartedAt = (Get-Date).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ssZ')
        }
    }
    finally {
        foreach ($key in @($secrets.Keys)) { $secrets[$key] = $null }
        $secrets.Clear()
        $psi = $null
    }
}

function Get-SecretValueForChild {
    <#
    .SYNOPSIS
        Retrieve a single secret value for immediate use in constructing a
        child-process environment or an authenticated request header.
    .DESCRIPTION
        Deliberately narrow. Callers must not write the returned value
        anywhere. Prefer Invoke-WithSecretEnv or Start-ProcessWithSecretEnv.
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$Key
    )

    $secrets = Read-SecretFile -Path $Path
    Assert-RequiredSecrets -Secrets $secrets -Required @($Key) -SourceLabel (Split-Path -Leaf $Path)
    $value = $secrets[$Key]
    foreach ($k in @($secrets.Keys)) { $secrets[$k] = $null }
    $secrets.Clear()
    return $value
}

Export-ModuleMember -Function Read-SecretFile, Assert-RequiredSecrets, Get-SecretFingerprint, ConvertTo-WindowsArgumentString,
    Invoke-WithSecretEnv, Start-ProcessWithSecretEnv, Start-DetachedProcessWithSecretEnv,
    Get-SecretValueForChild
