# Ignore rules for the visualizer application. Paths are anchored to this
# directory so the project can be treated as a standalone frontend project.
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.vite/
/.wrangler/
/outputs/
/work/

# local research artifacts and preview process files
/artifacts/
/.codex-dev.*
tsconfig.tsbuildinfo

# ---------------------------------------------------------------------------
# Build products of scripts/index-content.mjs
#
# Every entry point regenerates these before anything reads them - `npm run
# dev`, `npm run build`, `npm run build:netlify` and `npm test` all run the
# indexer first - so none of them belongs in git.
#
# Keeping them out is not only tidiness. The index now carries data fetched
# from Hugging Face, and a committed copy can silently disagree with the Hub;
# that is the same drift the .hf-cache rule below exists to prevent. It also
# stops a rebuild's timestamp showing up as a diff, so a content change is
# visible in review instead of buried in generated noise.
#
# After a fresh clone, run `npm run content:index` before `lint` or a
# type-check. Anything that builds or serves the site does it for you.
# ---------------------------------------------------------------------------

# The baked index: entry metadata, Petri scenario seeds, transcript summary rows.
/lib/generated/content-index.json

# Per-entry Markdown bodies, kept out of the shared index (see lib/body.ts).
/lib/generated/bodies/

# Per-transcript sidecars, sharded from content/ or fetched from HF per build.
/public/generated-transcripts/

# Dialogue chunks, sharded from content/ or fetched from HF per build.
/public/generated-datasets/

# Copies of each entry's non-Markdown files, made so the site can link them.
# Byte-identical to the originals under content/ - the source of truth.
/public/content-assets/

# Hugging Face build-time metadata cache. Safe to delete; the next build
# refetches. Keeping it out of git is what stops dataset metadata drifting
# between a developer's checkout and a Netlify build.
/.hf-cache/

# ---------------------------------------------------------------------------
# Re-include content payloads that the ROOT .gitignore would otherwise swallow
#
# The root file ignores `**/data/*.jsonl` and `**/data/*.json` to keep bulk
# training data out of git. That pattern also matches an entry's own seed and
# record files under content/<type>/<slug>/data/, so without these negations a
# newly added dataset or Petri entry loses its payload from the commit with no
# warning - `git status` simply does not mention it.
#
# These files are small, they are the scientific record rather than bulk data,
# and the AGENTS.md convention explicitly keeps inputs like seeds and rubrics in
# git. Bulk corpora still live on the Hub via `hf_source`.
# ---------------------------------------------------------------------------
!/content/**/data/*.jsonl
!/content/**/data/*.json
