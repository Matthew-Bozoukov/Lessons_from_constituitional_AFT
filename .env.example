# ABOUTME: Template for the repo-root .env file. Copy to .env and fill in values;
# ABOUTME: .env is gitignored and must never be committed. Rules: CLAUDE.md "Secrets".

# Generation + judging for the replication pipeline. All Claude calls go
# through OpenRouter; there is no direct Anthropic dependency on this path.
OPENROUTER_API_KEY=

# Hugging Face: dataset/adapter pulls and publishes, and (optionally) the
# dashboard build's manifest fetches. Use a fine-grained token with write access
# to HF_ORG.
HF_TOKEN=
# THE org every push lands in (src.huggingface.hf_org) — the single place the
# destination namespace is written down; no config or CLI carries one. Configs name
# the repo alone. Not a secret, so it is filled in here: this project publishes to
# LASR-Callum, and HF_TOKEN needs write access to it.
HF_ORG=LASR-Callum

# Petri/audit tooling only (auditor and judge roles). Not used by the
# replication pipeline.
ANTHROPIC_API_KEY=

# GPU rental (see the CLAUDE.md GPU playbook).
VAST_API_KEY=
RUNPOD_API_KEY=

# Optional: experiment tracking for training runs.
# WANDB_API_KEY=

# Tinker API key for gpt-oss fine-tuning (https://tinker.thinkingmachines.ai)
TINKER_API_KEY=

# Secondary OpenRouter key (spare credit pool); names only, never values
OPENROUTER_API_KEY_ALT=

USER_PREFIX=
