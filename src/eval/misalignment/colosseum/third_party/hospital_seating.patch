+def _resolve_agent_llm_configs_by_seat(
+    agent_names: Sequence[str],
+    pair: Sequence[str],
+    pair_llm_cfg: Dict[str, Any],
+    other_llm_cfg: Optional[Dict[str, Any]],
+) -> Dict[str, Dict[str, Any]]:
+    """One llm config per agent, chosen by SEAT: the watched pair, or everyone else.
+
+    Public Colosseum gives every agent one model — ``llm_models`` is a sweep axis and
+    the vLLM runtime holds exactly one spec. A mixed-team design needs the two watched
+    seats (the provisioner and one department) to hold one checkpoint while the rest of
+    the team holds another, in EVERY cell: the baseline cell has no adversaries at all,
+    yet the pair must still hold the block's model there. So assignment is by seat, not
+    by collusion role.
+
+    ``experiment.seating.pair`` names the seats; ``experiment.seating.other_llm`` is the
+    llm block for every other seat. Omit ``other_llm`` and every agent keeps the sweep's
+    own model, which is exactly upstream behaviour.
+    """
+    pair_set = {str(a) for a in (pair or [])}
+    if not other_llm_cfg:
+        return {str(a): copy.deepcopy(pair_llm_cfg) for a in agent_names}
+    missing = sorted(pair_set - {str(a) for a in agent_names})
+    if missing:
+        raise ValueError(
+            f"experiment.seating.pair names {missing}, which are not agents in this run "
+            f"({sorted(str(a) for a in agent_names)})."
+        )
+    return {
+        str(a): copy.deepcopy(pair_llm_cfg if str(a) in pair_set else other_llm_cfg)
+        for a in agent_names
+    }
+
+
+def _capture_llm_calls(client: Any) -> List[Dict[str, Any]]:
+    """Record every raw model reply a client receives — the reasoning trace included.
+
+    The agent loop keeps only the visible content of each reply: a reasoning model's
+    trace (``reasoning_content`` from vLLM's parser), the tool calls it made and the
+    finish reason are dropped. They ARE the rollout, so they are captured here and the
+    runner writes them into ``agent_turns.json`` turn by turn.
+    """
+    calls: List[Dict[str, Any]] = []
+    original = client.generate_response
+
+    def generate_response(input, params):  # noqa: A002 - upstream's parameter name
+        data, text = original(input=input, params=params)
+        choice: Dict[str, Any] = {}
+        try:
+            choice = (data.get("choices") or [{}])[0] or {}
+        except Exception:
+            choice = {}
+        message = choice.get("message") or {}
+        calls.append(
+            {
+                "reasoning": message.get("reasoning_content") or message.get("reasoning"),
+                "content": text,
+                "tool_calls": [
+                    {
+                        "name": (c.get("function") or {}).get("name"),
+                        "arguments": (c.get("function") or {}).get("arguments"),
+                    }
+                    for c in (message.get("tool_calls") or [])
+                ],
+                "finish_reason": choice.get("finish_reason"),
+                "usage": data.get("usage") if isinstance(data, dict) else None,
+            }
+        )
+        return data, text
+
+    client.generate_response = generate_response
+    return calls
+
