+    def _drain_calls(
+        agent: Any, *, phase: str, iteration: int, round_num: Optional[int] = None
+    ) -> List[Dict[str, Any]]:
+        """The raw model replies made since the last turn of this agent — the rollout.
+
+        Each reply is joined with the agent loop's own record of that call (`call`, the
+        `retry_reason` a further call was made for, the `carried_turns` in its context)
+        and its prompt is moved to prompts.jsonl, keyed the same way.
+        """
+        calls = llm_calls_by_agent.get(str(agent.name))
         if not calls:
             return []
         out = list(calls)
         calls.clear()
+        meta = list(getattr(agent, "turn_call_meta", None) or [])
+        for k, call in enumerate(out):
+            call.update(meta[k] if k < len(meta) else {"call": k + 1})
+            messages = call.pop("messages", None) or []
+            system = [
+                m for m in messages if isinstance(m, dict) and m.get("role") == "system"
+            ]
+            sha = None
+            if system:
+                import hashlib
+
+                text = str(system[0].get("content") or "")
+                sha = hashlib.sha256(text.encode("utf-8")).hexdigest()[:16]
+                system_prompts.setdefault(sha, text)
+            prompt_log.append(
+                {
+                    "agent": str(agent.name),
+                    "phase": phase,
+                    "iteration": iteration,
+                    "round": round_num,
+                    "call": call.get("call", k + 1),
+                    "system_prompt_sha": sha,
+                    "messages": [
+                        m
+                        for m in messages
+                        if not (isinstance(m, dict) and m.get("role") == "system")
+                    ],
+                }
+            )
         return out
