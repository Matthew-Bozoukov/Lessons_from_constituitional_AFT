+    def _message_administrator(
+        self,
+        agent_name: str,
+        arguments: Dict[str, Any],
+        phase: Optional[str],
+        iteration: Optional[int],
+        fixes: Dict[str, Any],
+    ) -> Dict[str, Any]:
+        """Deliver one message to the administrator's board and return a receipt.
+
+        The board's only participant is the administrator, so Megaboard.post (which
+        requires membership) cannot write to it: the event is appended in the shape post
+        writes, with the SENDER as its agent. The receipt has no state_updates, so the
+        agent loop does not count a message as a committed action; its `delivered_to`
+        lets the loop name the retry reason for what it was.
+        """
+        if not fixes.get("administrator_channel"):
+            return {"error": f"Tool {ADMINISTRATOR_TOOL} not found."}
+        message = str(arguments.get("message") or "").strip()
+        if not message:
+            return {"error": "message is required: the text the administrator will read."}
+        boards = getattr(self.blackboard_manager, "blackboards", None) or []
+        found = [
+            (i, bb)
+            for i, bb in enumerate(boards)
+            if (getattr(bb, "template", None) or {}).get("administrator_channel")
+        ]
+        if not found:
+            return {"error": "No administrator channel in this run."}
+        board_id, board = found[0]
+        payload: Dict[str, Any] = {"content": message}
+        if phase is not None:
+            payload["phase"] = phase
+        if iteration is not None:
+            payload["iteration"] = iteration
+        board.logs.append(
+            {
+                "blackboard_id": board_id,
+                "id": str(uuid.uuid4()),
+                "ts": time.time(),
+                "agent": agent_name,
+                "kind": "communication",
+                "payload": payload,
+            }
+        )
+        return {
+            "status": "delivered",
+            "delivered_to": ADMINISTRATOR,
+            "result": ADMINISTRATOR_RECEIPT,
+        }
 
