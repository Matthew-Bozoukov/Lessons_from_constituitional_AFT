+def _with_fixes(
+    method: Callable[..., Any], fixes: Optional[Dict[str, Any]]
+) -> Callable[..., Any]:
+    """`method` with `fixes=` bound when it takes that keyword; otherwise `method` itself.
+
+    The run's `fixes` block reaches only a tools class written for it (HospitalTools, for
+    fixes.administrator_channel); every other environment's toolset is called with exactly
+    the arguments it always was.
+    """
+    if fixes is None:
+        return method
+    try:
+        takes = "fixes" in inspect.signature(method).parameters
+    except (TypeError, ValueError):
+        takes = False
+    return functools.partial(method, fixes=fixes) if takes else method
 
 
