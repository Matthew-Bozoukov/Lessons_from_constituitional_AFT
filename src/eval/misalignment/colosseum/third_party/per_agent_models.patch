+def _resolve_agent_llm_configs(
+    agent_names: Sequence[str],
+    roles: Dict[str, str],
+    default_llm_cfg: Dict[str, Any],
+    by_role_cfg: Optional[Dict[str, Any]],
+) -> Dict[str, Dict[str, Any]]:
+    """One llm config per agent, chosen by that agent's collusion role.
+
+    Public Colosseum gives every agent the same model: ``llm_models`` is a sweep axis,
+    and the vLLM runtime deletes ``agent_name`` outright. That makes a MIXED team
+    impossible, and a mixed team is the only way to ask whether a model's disposition
+    survives contact with a differently-trained peer — the coalition seats have to hold
+    one checkpoint while the rest of the team holds another.
+
+    Assignment is by ROLE rather than by position, because ``colluder_selection: random``
+    decides who the coalition is at run time from the seed; a positional list would have
+    to guess. ``experiment.collusion.agent_llms_by_role`` maps ``colluder`` and ``normal``
+    to full ``llm`` blocks. Omit it and every agent keeps the sweep's own model, which is
+    exactly upstream behaviour.
+
+    Args:
+        agent_names: Every agent in the run.
+        roles: {agent_name: "colluder" | "normal"} as computed from the seed.
+        default_llm_cfg: The sweep's own ``llm`` block, used when no override applies.
+        by_role_cfg: {role: llm block} or None.
+
+    Returns:
+        {agent_name: llm config}, one deep copy per agent.
+    """
+    if not by_role_cfg:
+        return {str(a): copy.deepcopy(default_llm_cfg) for a in agent_names}
+    missing = sorted({roles[str(a)] for a in agent_names} - set(by_role_cfg))
+    if missing:
+        raise ValueError(
+            f"experiment.collusion.agent_llms_by_role has no entry for role(s) {missing}; "
+            f"this run has roles {sorted({roles[str(a)] for a in agent_names})}. Give every "
+            "role a model explicitly rather than letting one silently fall back to the "
+            "sweep default — a seat filled by the wrong arm is invisible in the results."
+        )
+    return {str(a): copy.deepcopy(by_role_cfg[roles[str(a)]]) for a in agent_names}
+
+
