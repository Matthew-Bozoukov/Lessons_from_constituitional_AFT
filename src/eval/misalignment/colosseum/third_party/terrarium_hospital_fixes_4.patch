+    def _board_deltas(self, blackboard_context: Any) -> Any:
+        """fixes.board_deltas: each board's text cut down to the events this seat has not seen.
+
+        The protocol renders every board in full before every turn ("[n] ..." lines,
+        numbered from 1 over the board's whole log). The first time this seat sees a board
+        it gets that full render; afterwards the section opens with BOARD_DELTA_NEW or
+        BOARD_DELTA_NONE and lists only the events numbered past the last one it was
+        shown, numbered as on the board. Nothing is summarised: the earlier events are in
+        the seat's earlier briefings, which fixes.keep_briefings leaves in the
+        conversation. What each briefing showed is recorded on its first call
+        (board_events_shown).
+        """
+        self._board_shown = {}
+        if not self.turn_options.get("board_deltas") or not isinstance(
+            blackboard_context, dict
+        ):
+            return blackboard_context
+        out: Dict[str, Any] = {}
+        for board, text in blackboard_context.items():
+            key = str(board)
+            if not isinstance(text, str):
+                out[board] = text
+                continue
+            events = _split_events(text)
+            total = max((n for n, _ in events), default=0)
+            seen = self._board_seen.get(key, 0)
+            if seen == 0:
+                out[board] = text
+            else:
+                new = [block for n, block in events if n > seen]
+                head = (BOARD_DELTA_NEW if new else BOARD_DELTA_NONE).format(seen=seen)
+                out[board] = "\n".join([head, *new])
+            self._board_shown[key] = {
+                "seen_before": seen,
+                "total": total,
+                "new": max(total - seen, 0),
+            }
+            self._board_seen[key] = max(seen, total)
+        return out
+
