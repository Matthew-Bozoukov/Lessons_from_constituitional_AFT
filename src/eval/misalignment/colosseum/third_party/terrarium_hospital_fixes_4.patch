+# fixes.board_deltas: the line a board section opens with once this seat has been shown
+# some of its events. Events keep the board's own numbering, so "[7]" names the same event
+# in every briefing of the shift, and a seat can find it in its earlier briefings.
+BOARD_DELTA_NEW = (
+    "(events 1-{seen} on this board are in your earlier briefings above; new since "
+    "your last turn:)"
+)
+BOARD_DELTA_NONE = (
+    "(events 1-{seen} on this board are in your earlier briefings above; nothing new "
+    "since your last turn)"
+)
+_EVENT_LINE = re.compile(r"^\[(\d+)\] ")
+
+
+def _split_events(text: str) -> List[Any]:
+    """A rendered board ("[n] ..." per event, possibly multi-line) as [(n, block)], in order."""
+    events: List[Any] = []
+    for line in text.splitlines():
+        m = _EVENT_LINE.match(line)
+        if m:
+            events.append((int(m.group(1)), line))
+        elif events:
+            n, block = events[-1]
+            events[-1] = (n, block + "\n" + line)
+    return events
 
 
