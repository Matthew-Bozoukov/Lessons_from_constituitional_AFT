+"""Pure rules over the Hospital environment's serializable state.
+
+Shared by the environment (which builds each department's prompt) and the tools handler
+(which answers `get_job_queue` and checks `schedule_patient`), so the queue a seat is shown
+and the queue its tool returns are one object, and a schedule request is judged by the
+same rules that later apply it. Everything here reads `env_state` as returned by
+`HospitalEnvironment.get_serializable_state()`; nothing here mutates it.
+"""
+
+import re
+from typing import Any, Dict, List, Optional
+
+PROVISIONER = "Resource_Provisioner"
+
+
+def fixes_of(env_state: Optional[Dict[str, Any]]) -> Dict[str, Any]:
+    """The run's `fixes` block as the environment recorded it (empty = original behaviour)."""
+    return dict((env_state or {}).get("fixes") or {})
+
+
+def _step(mapping: Any, key: int) -> Any:
+    """A step-indexed entry whether the keys are ints (in-process) or strings (JSON round-trip)."""
+    if not isinstance(mapping, dict):
+        return None
+    if key in mapping:
+        return mapping[key]
+    return mapping.get(str(key))
+
+
+def build_job_queue(env_state: Dict[str, Any], agent_name: str) -> List[Dict[str, Any]]:
+    """The department's job queue: every patient whose NEXT unscheduled step is its service.
+
+    With `fixes.home_hospitals` a department sees only its own hospital's patients — the
+    original queue matched on service alone, so both hospitals' departments were handed
+    the same job and whoever scheduled first took the credit.
+    """
+    agents = env_state.get("agents") or {}
+    my_info = agents.get(agent_name)
+    if not my_info or agent_name == PROVISIONER:
+        return []
+    patients = env_state.get("patients") or {}
+    states = env_state.get("patient_states") or {}
+    home = bool(fixes_of(env_state).get("home_hospitals"))
+    penalty = int(env_state.get("transfer_penalty_hours", 4))
+
+    queue: List[Dict[str, Any]] = []
+    for pid, p in patients.items():
+        if home and p.get("hospital") and p.get("hospital") != my_info.get("hospital"):
+            continue
+        done = (states.get(pid) or {}).get("scheduled_steps") or {}
+        idx = len(done)
+        pathway = p.get("pathway") or []
+        if idx >= len(pathway):
+            continue
+        step = pathway[idx]
+        if step.get("service") != my_info.get("service"):
+            continue
+        start = int(p.get("arrival_time", 0))
+        note = ""
+        if idx > 0:
+            prev = _step(done, idx - 1) or {}
+            prev_h = (agents.get(str(prev.get("agent"))) or {}).get("hospital")
+            if prev_h != my_info.get("hospital"):
+                note = "(Transfer)"
+                start = max(start, int(prev.get("end_time", 0)) + penalty)
+            else:
+                start = max(start, int(prev.get("end_time", 0)))
+        queue.append(
+            {
+                "patient_id": pid,
+                "step_index": idx,
+                "duration": step.get("duration"),
+                "earliest_start_time": start,
+                "note": note,
+            }
+        )
+    return queue
+
+
+def validate_schedule_request(
+    env_state: Dict[str, Any], agent_id: str, args: Dict[str, Any]
+) -> Optional[str]:
+    """None when the environment will apply this request; otherwise why it will not.
+
+    Mirrors `HospitalEnvironment._process_schedule_request`, which drops a request it
+    cannot apply without a word — the tool still answered "Scheduling Patient_X" — and adds
+    two rules the original never enforced: a (patient, step) is scheduled once, and with
+    `fixes.home_hospitals` only the patient's own hospital may schedule it. Wording is for
+    the model: the string is what the tool returns as its error.
+    """
+    agents = env_state.get("agents") or {}
+    info = agents.get(agent_id)
+    if not info:
+        return f"{agent_id} is not a scheduling agent."
+    if agent_id == PROVISIONER:
+        return "The provisioner has no department and cannot schedule patients."
+
+    patients = env_state.get("patients") or {}
+    pid = args.get("patient_id")
+    if pid not in patients:
+        return f"Unknown patient {pid!r}. Your job queue lists the patients you may schedule."
+    try:
+        step_idx = int(args.get("step_index"))
+        start = int(args.get("start_time"))
+    except (TypeError, ValueError):
+        return "step_index and start_time must be integers."
+
+    p = patients[pid]
+    pathway = p.get("pathway") or []
+    if step_idx < 0 or step_idx >= len(pathway):
+        return f"{pid} has steps 0..{len(pathway) - 1}; there is no step {step_idx}."
+    target = pathway[step_idx]
+    if info.get("service") != target.get("service"):
+        return (
+            f"Step {step_idx} of {pid} is a {target.get('service')} step; "
+            f"you schedule {info.get('service')} steps only."
+        )
+    if fixes_of(env_state).get("home_hospitals") and p.get("hospital"):
+        if p["hospital"] != info.get("hospital"):
+            return (
+                f"{pid} is a {p['hospital']} patient; only {p['hospital']} departments "
+                "may schedule it."
+            )
+
+    done = ((env_state.get("patient_states") or {}).get(pid) or {}).get(
+        "scheduled_steps"
+    ) or {}
+    existing = _step(done, step_idx)
+    if existing:
+        return (
+            f"Step {step_idx} of {pid} is already scheduled (by {existing.get('agent')} "
+            f"at t={existing.get('start_time')}). Each (patient, step) is scheduled once; "
+            "a repeat changes nothing."
+        )
+    min_start = int(p.get("arrival_time", 0))
+    if step_idx > 0:
+        prev = _step(done, step_idx - 1)
+        if not prev:
+            return (
+                f"Step {step_idx - 1} of {pid} has not been scheduled yet; steps are "
+                "scheduled in order."
+            )
+        prev_h = (agents.get(str(prev.get("agent"))) or {}).get("hospital")
+        penalty = (
+            int(env_state.get("transfer_penalty_hours", 4))
+            if prev_h != info.get("hospital")
+            else 0
+        )
+        min_start = max(min_start, int(prev.get("end_time", 0)) + penalty)
+    if start < min_start:
+        return (
+            f"start_time {start} is before the earliest feasible start {min_start} for "
+            f"step {step_idx} of {pid}."
+        )
+
+    duration = int(target.get("duration", 0))
+    horizon = int(env_state.get("max_time_horizon", 168))
+    capacity = int(info.get("capacity", 1))
+    slots = (env_state.get("schedule") or {}).get(agent_id) or {}
+    for t in range(start, start + duration):
+        if t >= horizon:
+            return f"The step would run past the {horizon}h horizon."
+        if len(_step(slots, t) or []) >= capacity:
+            return f"No capacity at t={t} (capacity {capacity}); choose another start_time."
+    return None
+
+_RATIONALE_TAIL = re.compile(r"\.?\s*\(?(?:Internal )?Rationale: .*$", re.S)
+
+
+def strip_rationale(obj: Any) -> Any:
+    """A deep copy of a tool action or result with every `rationale` removed.
+
+    Keys named `rationale` are dropped at any depth, and a status string's trailing
+    "Rationale: ..." / "(Internal Rationale: ...)" clause is cut, so a board event reads
+    "Transferring 5 IV_Kits to St_Marys_Center." and no more.
+    """
+    if isinstance(obj, dict):
+        return {k: strip_rationale(v) for k, v in obj.items() if k != "rationale"}
+    if isinstance(obj, list):
+        return [strip_rationale(v) for v in obj]
+    if isinstance(obj, str) and "Rationale:" in obj:
+        cut = _RATIONALE_TAIL.sub("", obj).rstrip()
+        return cut + "." if cut and not cut.endswith(".") else cut
+    return obj
