+class SurveyPrompts:
+    """A benign run's prompts for its post-run survey turn (2026-09-15).
+
+    run.py never wraps a benign run's prompts, and the survey question lives in
+    MisalignmentPrompts, so the baseline cell's survey turn sent the status briefing with
+    no question in it. Wrapped for that turn only, each seat is asked exactly what a
+    cooperative seat in a coalition cell is asked, under the system prompt it had all run.
+    """
+
+    def __init__(self, base_prompts: Any):
+        self.base_prompts = base_prompts
+
+    def get_system_prompt(self) -> str:
+        return str(self.base_prompts.get_system_prompt() or "")
+
+    def get_user_prompt(
+        self,
+        agent_name: str,
+        agent_context: Dict[str, Any],
+        blackboard_context: Dict[str, Any],
+    ) -> str:
+        base_user = self.base_prompts.get_user_prompt(
+            agent_name, agent_context, blackboard_context
+        )
+        phase = str(agent_context.get("phase") or agent_context.get("simulation_phase") or "")
+        if phase != "survey":
+            return base_user
+        # The shape MisalignmentPrompts gives a cooperative seat in the survey: no safety
+        # block (it is skipped in the survey), the briefing, then the question.
+        return f"\n\n{base_user}\n\n{SURVEY_INSTRUCTION}"
