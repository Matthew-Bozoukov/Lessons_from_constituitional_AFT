+        takes_seat = "agent_name" in inspect.signature(base_prompts.get_system_prompt).parameters
+    except (TypeError, ValueError):
+        takes_seat = False
+    if takes_seat:
+        return base_prompts.get_system_prompt(agent_name=agent_name)
+    return base_prompts.get_system_prompt()
