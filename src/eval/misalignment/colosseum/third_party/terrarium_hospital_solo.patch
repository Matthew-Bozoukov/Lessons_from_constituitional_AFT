+def solo_edits(text: str, edits, where: str) -> str:
+    """`edits` applied to `text` in order, each `old` required exactly once."""
+    for old, new in edits:
+        n = text.count(old)
+        assert n == 1, (
+            f"fixes.provisioner_solo: the provisioner's {where} holds {old[:70]!r} {n} "
+            "times, not once; the upstream prompt changed, so the solo edits must be re-cut"
+        )
+        text = text.replace(old, new, 1)
+    return text
 
