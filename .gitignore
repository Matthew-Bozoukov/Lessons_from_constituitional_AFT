# Repository-root ignore rules.
#
# This file carries repository-WIDE meaning. In particular the credential guard
# below must apply to every directory in the tree, including nested projects, so
# it deliberately lives here rather than in any one project. Project-local rules
# belong in that project's own .gitignore with paths anchored to itself
# (dashboard/.gitignore).

# ---- credentials: never commit, anywhere in the tree -------------------------
.env
.env.*
*.env
!*.env.example
*.pem
*.key
!**/public/**/*.key

# ---- Python -----------------------------------------------------------------
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# ---- Node / frontend --------------------------------------------------------
node_modules/
.next/
dist/
.turbo/
*.tsbuildinfo

# ---- Generated data and model artifacts -------------------------------------
# Datasets, corpora, caches and evaluation outputs are published to Hugging
# Face, not committed here. See CLAUDE.md.
output/
# ** so these match data/ directories at any depth: the root data/ staging dir
# and the dashboard content payloads alike.
**/data/*.jsonl
**/data/*.json
!**/data/.gitkeep
*.safetensors
wandb/

# synthdoc corpora live on HuggingFace, never in git and - with cleanup_local -
# not on disk either.
**/output/synthdoc/
**/output/synthdoc_cache/
**/output/synthdoc_smoke/
**/output/synthdoc_sweeps/

# ---- Vendored / third-party trees --------------------------------------------
# Vendored eval harnesses are committed; their run outputs are not.
src/eval/misalignment/third_party/agentic-misalignment/results/
src/eval/misalignment/third_party/**/__pycache__/

# ---- OS and runtime noise ----------------------------------------------------
.DS_Store
Thumbs.db
*.log
.codex-dev.pid

# ---- Netlify local state and generated upload archives -----------------------
**/.netlify/
/deploy-*.zip

# ---- Local scratch that must never be committed ------------------------------
ResearchLog-PASTE-REDUNDANT/

# local vendored repos at the root (the tracked vendored harnesses live under src/eval/misalignment/third_party/)
/third_party/

# ---- Petri audit run artifacts ------------------------------------------------
# The .eval logs, per-transcript shards and bulk JSONL for a constitution dose
# sweep run to roughly 12 MB. They are published to Hugging Face and the
# dashboard entry pins the revision, so the Hub copy is canonical - the repo
# keeps the code, the config and the writeup. See
# src/eval/vulnerabilities/petri/constitution_sweep/README.md.
output/petri/
**/petri/logs/
**/petri/.venv/

# Published export bundles: the card, report and figures are the record and are
# committed with the dashboard entry; the payload beside them is not.
**/exports/*/transcripts/
**/exports/*/results/transcripts.jsonl
**/exports/*/manifest.json
**/exports/*/artifacts/raw-judge-dimensions.jsonl
